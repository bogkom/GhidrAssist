        parser.error("profile-select requires CPU32_SURVEY or MC68332_USER_SELECTED")
    try:
        params = ({"source_file":args.input,"output_file":args.output,
                   "objective":args.query,"profile":args.profile,
                   "expected_program_revision":args.expected_revision,
                   "expected_import_sha256":args.expected_import_sha256,
                   "expected_program_path":args.expected_program_path,
                   "confirm_local_sidecar":args.confirm_local_sidecar}
                  if method=="agentic.review.binding.create" else
                  {"tab":args.address} if method=="ui.tab.select" else
                  {"table":args.address, "row":args.row} if method=="ui.table.select" else
                  {"path":args.address} if method=="project.program.open" else
                  {"index":args.row} if method=="hardware.review.prepare" else
                  {"token":args.token,"name":args.name} if method=="hardware.review.apply" else
                  {"address":args.address or "", "offset":args.offset, "limit":args.limit,
                   **({"expected_revision":args.expected_revision} if args.expected_revision is not None else {})}
                  if method=="listing.range" else
                  {"offset":args.offset, "limit":args.limit, "direction":args.direction,
                   "expected_entry":args.expected_entry,
                   **({"expected_revision":args.expected_revision} if args.expected_revision is not None else {})}
                  if method=="function.xrefs.body" else
                  {"offset":args.offset,"limit":args.page_size,
                   **({"expected_revision":args.expected_revision} if args.expected_revision is not None else {}),
                   **({"expected_generation":args.expected_generation} if args.expected_generation else {})}
                  if method=="hardware.source_pairs.page" else
                  {"format":args.format, "offset":args.offset, "limit":args.limit,
                   **({"expected_revision":args.expected_report_revision}
                      if args.expected_report_revision else {}),
                   **({"expected_generation":args.expected_generation}
                      if args.expected_generation else {})}
                  if method in ("analysis.report","analysis.export") else
                  {"offset":args.offset, "limit":args.limit,
                   **({"expected_run":args.expected_run} if args.expected_run else {}),
                   **({"expected_findings_revision":args.expected_findings_revision} if args.expected_findings_revision is not None else {}),
                   **({"expected_program_revision":args.expected_revision} if args.expected_revision is not None else {})}
                  if method=="agentic.findings.page" else
                  {"origin": args.origin, "entry": args.address or "", "max_depth": args.max_depth, "offset": args.offset, "limit": args.limit} if method == "analysis.paths" else
                  {"profile": args.address} if method == "hardware.profile.select" else
                  {"address": args.address} if args.address else
                  {"offset": args.offset, "limit": args.limit, "task_id": args.task_id}
                  if method == "decompiler.status" else
                  {"filter": args.filter, "offset": args.offset, "limit": args.limit}
                  if method in ("hardware.mmio.rows", "hardware.review.preview", "function.xrefs") else {})
        reply = rpc(session, method, params)
        print(json.dumps(reply, indent=2))
    except HTTPError as error:
        print(error.read().decode("utf-8", errors="replace"), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
