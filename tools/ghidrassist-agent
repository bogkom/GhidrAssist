def _decode_checkpoint_json(raw):
    """Decode one already size-bounded offline receipt without ambiguous JSON.

    Python's default JSON parser silently keeps the *last* duplicate object
    key and permits NaN/Infinity. Either can produce a SHA-valid but ambiguous
    evidence receipt after an attacker rehashes its parsed payload. Reject
    duplicates at every depth, escaped-key aliases, non-finite numbers and
    implausibly long numeric tokens. This validates syntax, NOT authorship.
    """
    def unique_object(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("Duplicate checkpoint JSON key: " + key)
            result[key] = value
        return result

    def bounded_integer(token):
        if len(token.lstrip("-")) > 64:
            raise ValueError("Oversized checkpoint JSON integer")
        return int(token)

    def bounded_float(token):
        if len(token) > 128:
            raise ValueError("Oversized checkpoint JSON float")
        number = float(token)
        if not math.isfinite(number):
            raise ValueError("Non-finite checkpoint JSON number")
        return number

    def reject_constant(token):
        raise ValueError("Non-finite checkpoint JSON constant: " + token)

    try:
        decoded = raw.decode("utf-8")
        # The standard parser's recursion tolerance differs across Python
        # versions. Bound structural nesting explicitly before allocation,
        # ignoring bracket characters inside quoted/escaped JSON strings.
        depth = 0
        quoted = False
        escaped = False
        for char in decoded:
            if quoted:
                if escaped:
                    escaped = False
                elif char == "\\":
                    escaped = True
                elif char == '"':
                    quoted = False
            elif char == '"':
                quoted = True
            elif char in "[{":
                depth += 1
                if depth > 64:
                    raise ValueError("Checkpoint JSON nesting exceeds 64")
            elif char in "]}":
                depth -= 1
                if depth < 0:
                    raise ValueError("Invalid checkpoint JSON bracket")
        return json.loads(decoded, object_pairs_hook=unique_object,
                          parse_int=bounded_integer, parse_float=bounded_float,
                          parse_constant=reject_constant)
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError,
            OverflowError) as error:
        raise ValueError("Malformed offline checkpoint JSON") from error


SESSION_MAX_BYTES = 16384
RPC_RESPONSE_MAX_BYTES = 1048576


def load_session(path):
    """Read only a bounded local Automation v3 bearer session receipt."""
    location = Path(path).expanduser()
    with location.open("rb") as stream:
        raw = stream.read(SESSION_MAX_BYTES + 1)
    if not raw or len(raw) > SESSION_MAX_BYTES:
        raise ValueError("Missing or oversized Automation session receipt")
    session = _decode_checkpoint_json(raw)
    port = session.get("port") if isinstance(session, dict) else None
    token = session.get("token") if isinstance(session, dict) else None
    if (not isinstance(session, dict)
            or type(session.get("schema")) is not int or session["schema"] != 3
            or type(port) is not int or not 0 < port < 65536
            or not isinstance(token, str) or not 1 <= len(token) <= 256
            or re.fullmatch(r"[A-Za-z0-9._~+/-]+={0,2}", token) is None):
        raise ValueError("Invalid Automation session schema, port or bearer token")
    # Preserve launcher-specific metadata such as pid/mode; no new authority
    # or write permission is inferred from a locally edited receipt.
    return session


def rpc(session, method, params=None):
    """One bounded loopback Bearer JSON-RPC exchange; never guess truncation."""
    payload = json.dumps({"method": method, "params": params or {}},
                         allow_nan=False).encode("utf-8")
    req = Request(
        "http://127.0.0.1:%d/rpc" % session["port"],
        data=payload,
        headers={"Content-Type": "application/json",
                 "Authorization": "Bearer " + session["token"]},
        method="POST",
    )
    with urlopen(req, timeout=45) as answer:
        raw = answer.read(RPC_RESPONSE_MAX_BYTES + 1)
    # An otherwise valid JSON object followed by >1 MiB of whitespace is
    # still an oversized reply. Reading only 1 MiB silently accepted it.
    if not raw or len(raw) > RPC_RESPONSE_MAX_BYTES:
        raise ValueError("Empty or oversized Automation JSON-RPC response")
    response = _decode_checkpoint_json(raw)
    if not isinstance(response, dict):
        raise ValueError("Automation JSON-RPC response must be an object")
    return response


def _source_pairs_metadata(page, legacy=False):
    """Immutable source-generation identity and bounded inventory counters."""
    fields = ("schema", "revision", "generation", "import_sha256",
              "profile", "total_pairs", "indirect_sources",
              "movec_sources", "omitted_indirect", "omitted_movec",
              "reset_root_recognized", "reset_graph_incomplete",
              "observed_inventory_incomplete", "stage_epoch",
              "functions_with_both_sources", "indirect_only_functions",
              "movec_only_functions", "indirect_only_sites",
              "movec_only_sites", "reset_visited_functions_with_both",
              "coverage_incomplete")
    if legacy:
        fields=fields[:14]
    identity = tuple(page[key] for key in fields)
    if (page["schema"] != 1 or page["profile"] != "MC68332_USER_SELECTED"
            or type(page["revision"]) != int or page["revision"] < 0
            or type(page["stage_epoch"]) != int or page["stage_epoch"] < 0
            or not isinstance(page["generation"], str)
            or not 1 <= len(page["generation"]) <= 128
            or not isinstance(page["import_sha256"], str)
            or len(page["import_sha256"]) > 128
            or any(type(page[k]) != int or page[k] < 0 for k in
                   ("total_pairs", "indirect_sources", "movec_sources",
                    "omitted_indirect", "omitted_movec"))
            or page["indirect_sources"] > 64 or page["movec_sources"] > 32
            or page["total_pairs"] > 2048
            or page["total_pairs"] > (page["indirect_sources"] *
                                       page["movec_sources"])
            or any(type(page[k]) != bool for k in
                   ("reset_root_recognized", "reset_graph_incomplete",
                    "observed_inventory_incomplete"))):
        raise ValueError("Invalid bounded source inventory metadata")
    if legacy:
        return identity
    coverage = ("functions_with_both_sources", "indirect_only_functions",
                "movec_only_functions", "indirect_only_sites",
                "movec_only_sites", "reset_visited_functions_with_both")
    if (any(type(page[k]) != int or page[k] < 0 for k in coverage)
            or type(page["coverage_incomplete"]) != bool
            or page["functions_with_both_sources"] > min(
                page["indirect_sources"], page["movec_sources"])
            or page["indirect_only_functions"] > page["indirect_only_sites"]
            or page["movec_only_functions"] > page["movec_only_sites"]
            or page["indirect_only_sites"] > page["indirect_sources"]
            or page["movec_only_sites"] > page["movec_sources"]
            or page["reset_visited_functions_with_both"] >
               page["functions_with_both_sources"]
            or page["coverage_incomplete"] != (
                page["observed_inventory_incomplete"]
                or not page["reset_root_recognized"])):
        raise ValueError("Contradictory unmatched source coverage")
    return identity


def _validate_source_pair_row(row):
    """Preserve CPU32 source-site identity even for rehashed offline receipts."""
    coords = ("function", "indirectPc", "indirectTarget", "vbrPc")
    if (not isinstance(row, dict) or any(
            type(row.get(k)) != int or not 0 <= row[k] <= 0xffffff
            or row[k] & 1 for k in coords)
            or row["indirectPc"] < row["function"]
            or row["vbrPc"] < row["function"]
            or row["indirectPc"] == row["vbrPc"]
            or type(row.get("mayMm")) != bool
            or type(row.get("uncertain")) != bool):
        raise ValueError("Invalid selected-CPU32 source row")


def capture_source_pairs_checkpoint(session, output, page_size=32):
    """Read-only, versioned, atomic local source evidence; never Analyze/Apply."""
    if not 1 <= page_size <= 32:
        raise ValueError("Source pair page size must be 1..32")
    first = rpc(session, "hardware.source_pairs.page",
                {"offset": 0, "limit": page_size})["source_pairs"]
    expected = _source_pairs_metadata(first)
    rows = []
    current = first
    while True:
        if _source_pairs_metadata(current) != expected:
            raise ValueError("Source revision/generation changed during pagination")
        if (type(current["offset"]) != int or current["offset"] != len(rows)
                or type(current["limit"]) != int or current["limit"] != page_size
                or type(current["next_offset"]) != int
                or type(current["has_more"]) != bool
                or type(current["displayed"]) != int
                or not isinstance(current["rows"], list)
                or current["displayed"] != len(current["rows"])
                or len(current["rows"]) > page_size
                or current["next_offset"] != len(rows)+len(current["rows"])
                or current["next_offset"] > expected[5]
                or current["has_more"] != (
                    current["next_offset"] < expected[5])):
            raise ValueError("Inconsistent bounded source page or cursor")
        if current["has_more"] and not current["rows"]:
            raise ValueError("Source page made no progress")
        rows.extend(current["rows"])
        if not current["has_more"]:
            break
        current = rpc(session, "hardware.source_pairs.page", {
            "offset": len(rows), "limit": page_size,
            "expected_revision": expected[1],
            "expected_generation": expected[2]})["source_pairs"]
    if len(rows) != expected[5]:
        raise ValueError("Source pair collection omitted observed pairs")
    # The terminal read is a generation fence: a last-page response alone
    # cannot detect a new Analyze after that response but before publication.
    terminal = rpc(session, "hardware.source_pairs.page", {
        "offset": len(rows), "limit": page_size,
        "expected_revision": expected[1],
        "expected_generation": expected[2]})["source_pairs"]
    if (_source_pairs_metadata(terminal) != expected
            or type(terminal.get("offset")) != int
            or terminal["offset"] != len(rows)
            or type(terminal.get("limit")) != int
            or terminal["limit"] != page_size
            or type(terminal.get("next_offset")) != int
            or terminal["next_offset"] != len(rows)
            or type(terminal.get("displayed")) != int
            or terminal["displayed"] != 0
            or terminal.get("rows") != []
            or terminal.get("has_more") is not False):
        raise ValueError("Source generation changed at terminal evidence fence")
    keys = []
    for row in rows:
        _validate_source_pair_row(row)
        keys.append((row["function"], row["indirectPc"], row["vbrPc"]))
    if len(set(keys)) != len(keys) or keys != sorted(keys):
        raise ValueError("Duplicate or unsorted source evidence")
    if len({row["function"] for row in rows}) != first["functions_with_both_sources"]:
        raise ValueError("Source pair function coverage mismatch")
    # Source completeness is a bounded observation, not firmware execution.
    sha=expected[3]
    valid_import=len(sha)==64 and all(c in "0123456789abcdefABCDEF" for c in sha)
    complete = bool(rows and valid_import and not expected[12] and
                    expected[8] == 0 and expected[9] == 0 and
                    expected[10] and not expected[11])
    payload = {
        "schema": 1, "kind": "ghidrassist-hardware-source-pairs",
        "program_revision": expected[1], "generation": expected[2],
        "import_sha256": expected[3], "profile": expected[4],
        "total_pairs": expected[5], "indirect_sources": expected[6],
        "movec_sources": expected[7], "omitted_indirect": expected[8],
        "omitted_movec": expected[9], "reset_root_recognized": expected[10],
        "reset_graph_incomplete": expected[11],
        "observed_inventory_incomplete": expected[12],
        "stage_epoch": expected[13],
        **{key: first[key] for key in (
            "functions_with_both_sources", "indirect_only_functions",
            "movec_only_functions", "indirect_only_sites",
            "movec_only_sites", "reset_visited_functions_with_both",
            "coverage_incomplete")},
        "collected_all_observed_pairs": True,
        "bounded_source_complete": complete, "rows": rows,
        "notice": "STATIC SOURCE-ONLY: not executable CALL, MM/VBR, ISR, Apply or cross-revision resume",
    }
    canonical=json.dumps(payload,sort_keys=True,separators=(",",":"),
                         ensure_ascii=False).encode("utf-8")
    digest=hashlib.sha256(canonical).hexdigest()
    envelope={"payload":payload,"payload_sha256":digest}
    data=(json.dumps(envelope,indent=2,ensure_ascii=False)+"\n").encode("utf-8")
    if len(data)>1024*1024:
        raise ValueError("Source checkpoint exceeds 1 MiB cap")
    dest=Path(output).expanduser()
    if not dest.parent.is_dir():
        raise ValueError("Checkpoint directory must already exist")
    temp=None
    try:
        fd,temp=tempfile.mkstemp(prefix=".ghidrassist-source-pairs-",dir=dest.parent)
        with os.fdopen(fd,"wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.link(temp,dest)
    finally:
        if temp is not None:
            os.unlink(temp)
    return {"saved":str(dest),"total_pairs":len(rows),
            "bounded_source_complete":complete,"payload_sha256":digest}


def verify_source_pairs_checkpoint(source, _include_payload=False):
    """Offline hash/count/provenance integrity check; never authorizes replay."""
    path=Path(source).expanduser()
    with path.open("rb") as handle:
        raw=handle.read(1024*1024+1)
    if len(raw)>1024*1024:
        raise ValueError("Oversized source checkpoint")
    envelope=_decode_checkpoint_json(raw)
    if not isinstance(envelope,dict) or not isinstance(envelope.get("payload"),dict):
        raise ValueError("Invalid source checkpoint envelope")
    p=envelope["payload"]
    if p.get("schema")!=1 or p.get("kind")!="ghidrassist-hardware-source-pairs":
        raise ValueError("Unsupported source checkpoint kind")
    canonical=json.dumps(p,sort_keys=True,separators=(",",":"),
                         ensure_ascii=False).encode("utf-8")
    digest=hashlib.sha256(canonical).hexdigest()
    if digest!=envelope.get("payload_sha256"):
        raise ValueError("Source checkpoint SHA-256 mismatch")
    coverage_keys = (
        "functions_with_both_sources", "indirect_only_functions",
        "movec_only_functions", "indirect_only_sites",
        "movec_only_sites", "reset_visited_functions_with_both",
        "coverage_incomplete")
    present=[key in p for key in coverage_keys]
    if any(present) and not all(present):
        raise ValueError("Incomplete source checkpoint coverage fields")
    legacy=not any(present)
    metadata={
        "schema":p["schema"],"revision":p["program_revision"],
        "generation":p["generation"],"import_sha256":p["import_sha256"],
        "profile":p["profile"],"total_pairs":p["total_pairs"],
        "indirect_sources":p["indirect_sources"],"movec_sources":p["movec_sources"],
        "omitted_indirect":p["omitted_indirect"],"omitted_movec":p["omitted_movec"],
        "reset_root_recognized":p["reset_root_recognized"],
        "reset_graph_incomplete":p["reset_graph_incomplete"],
        "observed_inventory_incomplete":p["observed_inventory_incomplete"],
        "stage_epoch":p["stage_epoch"],
        **({key:p[key] for key in coverage_keys} if not legacy else {}),
    }
    values=_source_pairs_metadata(metadata,legacy=legacy)
    rows=p["rows"]
    if (not isinstance(rows,list) or len(rows)!=values[5] or
            type(p.get("collected_all_observed_pairs"))!=bool or
            not p["collected_all_observed_pairs"] or
            type(p.get("bounded_source_complete"))!=bool):
        raise ValueError("Inconsistent checkpoint rows/completeness")
    keys=[]
    for row in rows:
        _validate_source_pair_row(row)
        keys.append((row["function"],row["indirectPc"],row["vbrPc"]))
    if len(set(keys))!=len(keys) or keys!=sorted(keys):
        raise ValueError("Invalid source pair ordering")
    # The saved full pair set must agree with its independent function
    # coverage, without interpreting absent matches as absent hardware effects.
    observed_both=len({row["function"] for row in rows})
    if not legacy and observed_both!=p["functions_with_both_sources"]:
        raise ValueError("Source pair function coverage mismatch")
    sha=values[3]
    valid_import=len(sha)==64 and all(c in "0123456789abcdefABCDEF" for c in sha)
    eligible=bool(rows and valid_import and not values[12] and values[8]==0 and values[9]==0
                  and values[10] and not values[11])
    if p["bounded_source_complete"]!=eligible:
        raise ValueError("False source-inventory completeness")
    return {"verified":True,"payload_sha256":digest,
            "total_pairs":len(rows),"bounded_source_complete":eligible,
            "source_coverage":(
                {key:p[key] for key in coverage_keys} if not legacy else None),
            "coverage_available":not legacy,
            "resume_authorized":False,
            **({"_validated_payload":p} if _include_payload else {})}


def read_source_pairs_checkpoint_page(source, offset=0, limit=32):
    """Offline bounded browse of one hash-verified snapshot; no live RPC/replay."""
    if (type(offset) is not int or type(limit) is not int or
            not 0 <= offset <= 1000000 or not 1 <= limit <= 32):
        raise ValueError("Invalid bounded offline source-pair page")
    verified = verify_source_pairs_checkpoint(source, _include_payload=True)
    payload = verified.pop("_validated_payload")
    rows = payload["rows"]
    start = min(offset, len(rows))
    end = min(start + limit, len(rows))
    return {
        "offline": True, "read_only": True,
        "verified_sha256": verified["payload_sha256"],
        "program_revision": payload["program_revision"],
        "generation": payload["generation"],
        "import_sha256": payload["import_sha256"],
        "profile": payload["profile"],
        "total_pairs": len(rows), "offset": offset, "limit": limit,
        "has_more": end < len(rows),
        "bounded_source_complete": verified["bounded_source_complete"],
        "coverage_available": verified["coverage_available"],
        "source_coverage": verified["source_coverage"],
        "resume_authorized": False,
        "rows": rows[start:end],
        "notice": "Historical static evidence only; no live Ghidra, MM/VBR activation or Apply",
    }


def check_source_pairs_resume_preflight(session, source, page_size=32):
    """Read-only live rebind of historical static evidence; never restore execution."""
    if type(page_size) is not int or not 1 <= page_size <= 32:
        raise ValueError("Invalid source rebind page size")
    verified = verify_source_pairs_checkpoint(source, _include_payload=True)
    saved = verified["_validated_payload"]
    if not verified["coverage_available"]:
        raise ValueError("Legacy source inventory cannot be live-rebound without coverage")
    # A source digest and revision alone do not prove equality of evidence.
    # Re-read every row, compare the entire inventory, then fence generation.
    expected = {
        "schema": saved["schema"], "revision": saved["program_revision"],
        "generation": saved["generation"], "import_sha256": saved["import_sha256"],
        "profile": saved["profile"], "total_pairs": saved["total_pairs"],
        "indirect_sources": saved["indirect_sources"],
        "movec_sources": saved["movec_sources"],
        "omitted_indirect": saved["omitted_indirect"],
        "omitted_movec": saved["omitted_movec"],
        "reset_root_recognized": saved["reset_root_recognized"],
        "reset_graph_incomplete": saved["reset_graph_incomplete"],
        "observed_inventory_incomplete": saved["observed_inventory_incomplete"],
        "stage_epoch": saved["stage_epoch"],
        **{key: saved[key] for key in (
            "functions_with_both_sources", "indirect_only_functions",
            "movec_only_functions", "indirect_only_sites", "movec_only_sites",
            "reset_visited_functions_with_both", "coverage_incomplete")},
    }
    identity = _source_pairs_metadata(expected)
    rows = saved["rows"]
    for offset in range(0, len(rows) + 1, page_size):
        reply = rpc(session, "hardware.source_pairs.page", {
            "offset": offset, "limit": page_size,
            "expected_revision": saved["program_revision"],
            "expected_generation": saved["generation"]})
        if reply.get("read_only") is not True:
            raise ValueError("Live source provider is not explicitly read-only")
        live = reply["source_pairs"]
        if _source_pairs_metadata(live) != identity:
            raise ValueError("Live source identity or inventory differs from checkpoint")
        chunk = rows[offset:offset + page_size]
        next_offset = offset + len(chunk)
        if (type(live.get("offset")) is not int or live["offset"] != offset
                or type(live.get("limit")) is not int or live["limit"] != page_size
                or type(live.get("displayed")) is not int
                or live["displayed"] != len(chunk)
                or type(live.get("next_offset")) is not int
                or live["next_offset"] != next_offset
                or live.get("has_more") is not (next_offset < len(rows))
                or live.get("rows") != chunk):
            raise ValueError("Live source rows, pagination or cursor differ")
    # When total_pairs is an exact multiple of page_size, the loop above
    # includes the terminal empty page. Otherwise explicitly fence the end.
    if len(rows) % page_size:
        reply = rpc(session, "hardware.source_pairs.page", {
            "offset": len(rows), "limit": page_size,
            "expected_revision": saved["program_revision"],
            "expected_generation": saved["generation"]})
        live = reply["source_pairs"]
        if (reply.get("read_only") is not True
                or _source_pairs_metadata(live) != identity
                or type(live.get("offset")) is not int
                or live["offset"] != len(rows)
                or type(live.get("next_offset")) is not int
                or live["next_offset"] != len(rows)
                or type(live.get("limit")) is not int
                or live["limit"] != page_size
                or type(live.get("displayed")) is not int
                or live["displayed"] != 0
                or live.get("rows") != []
                or live.get("has_more") is not False):
            raise ValueError("Live source changed at terminal generation fence")
    return {
        "verified_sha256": verified["payload_sha256"],
        "identity_matches": True, "evidence_matches": True,
        "total_pairs": len(rows),
        "bounded_source_complete": verified["bounded_source_complete"],
        "read_only": True, "resume_authorized": False,
        "apply_authorized": False, "tool_execution_authorized": False,
        "next_action": "NEW_REVIEW_REQUIRED",
        "notice": "Static source rebind only; not execution, active MM/VBR/ISR, or Apply",
    }


REPORT_MAX_UNITS = 1024 * 1024
REPORT_MAX_BYTES = 2500000
REPORT_IDENTITY = ("format", "revision", "program_revision", "generation",
                   "stage_epoch", "import_sha256", "profile", "program_path",
                   "total_characters", "scope")


def _utf16_units(content):
    # Ghidra's String.length()/substring offsets count UTF-16 code units.
    return len(content.encode("utf-16-le", "surrogatepass")) // 2


def _report_identity(page):
    if not isinstance(page, dict):
        raise ValueError("Invalid report page")
    try:
        values = {key: page[key] for key in REPORT_IDENTITY}
    except KeyError as error:
        raise ValueError("Missing report provenance field") from error
    if (values["format"] not in ("markdown", "config_csv", "names_csv")
            or type(values["program_revision"]) != int
            or values["program_revision"] < 0
            or type(values["stage_epoch"]) != int
            or values["stage_epoch"] < 0
            or type(values["total_characters"]) != int
            or not 0 <= values["total_characters"] <= REPORT_MAX_UNITS
            or not isinstance(values["revision"], str)
            or not 1 <= len(values["revision"]) <= 512
            or not isinstance(values["generation"], str)
            or re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}",
                            values["generation"]) is None
            or not isinstance(values["import_sha256"], str)
            or re.fullmatch(r"[0-9a-fA-F]{64}", values["import_sha256"]) is None
            or values["profile"] not in ("CPU32_SURVEY", "MC68332_USER_SELECTED")
            or not isinstance(values["program_path"], str)
            or not values["program_path"].startswith("/")
            or not 1 <= len(values["program_path"]) <= 1024
            or values["scope"] !=
               "STATIC EVIDENCE ONLY; NO EXECUTION OR PHYSICAL MAPPING"):
        raise ValueError("Invalid bounded report provenance")
    return values


def _report_page_check(page, expected, offset, page_size):
    if _report_identity(page) != expected:
        raise ValueError("Report Program, format, revision or generation changed")
    text = page.get("text")
    if (type(page.get("offset")) != int or page["offset"] != offset
            or type(page.get("limit")) != int or page["limit"] != page_size
            or type(page.get("more")) != bool or not isinstance(text, str)):
        raise ValueError("Inconsistent report page cursor")
    units = _utf16_units(text)
    next_offset = offset + units
    if (units > page_size or next_offset > expected["total_characters"]
            or page["more"] != (next_offset < expected["total_characters"])):
        raise ValueError("Incomplete or overlong report fragment")
    if page["more"] and units == 0:
        raise ValueError("Report page made no progress")
    return units


def capture_report_checkpoint(session, output, fmt="markdown", page_size=4096):
    """Atomically capture all exact Ghidra report pages, no Analyze or Apply."""
    if fmt not in ("markdown", "config_csv", "names_csv") or not 1 <= page_size <= 8192:
        raise ValueError("Unsupported report format or page size")
    first = rpc(session, "analysis.export", {
        "format": fmt, "offset": 0, "limit": page_size})["report"]
    metadata = _report_identity(first)
    if metadata["format"] != fmt:
        raise ValueError("Wrong report format returned")
    offset = 0
    fragments = []
    current = first
    while True:
        units = _report_page_check(current, metadata, offset, page_size)
        fragments.append(current["text"])
        offset += units
        if not current["more"]:
            if offset != metadata["total_characters"]:
                raise ValueError("Report ended before complete content")
            break
        current = rpc(session, "analysis.export", {
            "format": fmt, "offset": offset, "limit": page_size,
            "expected_revision": metadata["revision"],
            "expected_generation": metadata["generation"]})["report"]
    # One last exact-cursor request catches a Program/revision/same-revision
    # Analyze rerun just after the last content page and before publication.
    terminal = rpc(session, "analysis.export", {
        "format": fmt, "offset": offset, "limit": page_size,
        "expected_revision": metadata["revision"],
        "expected_generation": metadata["generation"]})["report"]
    if (_report_page_check(terminal, metadata, offset, page_size) != 0
            or terminal["more"] or terminal["text"]):
        raise ValueError("Changed or trailing report after final page")
    # Normalize any UTF-16 surrogate pair split across two Ghidra pages.
    content = "".join(fragments).encode("utf-16-le", "surrogatepass").decode("utf-16-le")
    if _utf16_units(content) != offset:
        raise ValueError("Report UTF-16 content changed after stitching")
    payload = {
        "schema": 1, "kind": "ghidrassist-readonly-hardware-report",
        "metadata": metadata, "content": content, "complete": True,
        "read_only": True, "apply_authorized": False,
        "notice": "STATIC SOURCE EVIDENCE ONLY: not execution, signed provenance, Review/Apply approval or model resume",
    }
    canonical = json.dumps(payload, sort_keys=True, separators=(",",":"),
                           ensure_ascii=True).encode("utf-8")
    digest = hashlib.sha256(canonical).hexdigest()
    data = (json.dumps({"payload":payload,"payload_sha256":digest},
                       indent=2,ensure_ascii=True)+"\n").encode("utf-8")
    if len(data) > REPORT_MAX_BYTES:
        raise ValueError("Report checkpoint exceeds 2.5 MB")
    target = Path(output).expanduser()
    if not target.parent.is_dir() or target.parent.is_symlink():
        raise ValueError("Report output directory must be an existing real directory")
    temp = None
    try:
        descriptor, temp = tempfile.mkstemp(prefix=".ghidrassist-report-",dir=target.parent)
        with os.fdopen(descriptor,"wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        # Exclusive local publication, never overwrite a reviewed receipt.
        os.link(temp,target)
    finally:
        if temp is not None:
            os.unlink(temp)
    return {"saved":str(target),"report_sha256":digest,
            "report_generation":metadata["generation"],
            "total_characters":offset,
            "complete":True,"read_only":True,"apply_authorized":False}


def verify_report_checkpoint(source):
    """Offline read-only verification; SHA-256 is NOT an actor signature."""
    with Path(source).expanduser().open("rb") as handle:
        raw = handle.read(REPORT_MAX_BYTES + 1)
    if not raw or len(raw)>REPORT_MAX_BYTES:
        raise ValueError("Missing or oversized report checkpoint")
    envelope = _decode_checkpoint_json(raw)
    if not isinstance(envelope,dict) or set(envelope)!={"payload","payload_sha256"}:
        raise ValueError("Invalid report envelope")
    payload = envelope["payload"]
    if not isinstance(payload,dict) or set(payload)!={
            "schema","kind","metadata","content","complete","read_only",
            "apply_authorized","notice"}:
        raise ValueError("Invalid report payload fields")
    if (type(payload["schema"])!=int or payload["schema"]!=1
            or payload["kind"]!="ghidrassist-readonly-hardware-report"
            or payload["complete"] is not True
            or payload["read_only"] is not True
            or payload["apply_authorized"] is not False
            or not isinstance(payload["content"],str)
            or not isinstance(payload["notice"],str)
            or not payload["notice"].startswith("STATIC SOURCE EVIDENCE ONLY")):
        raise ValueError("Invalid report checkpoint scope or authority")
    identity = _report_identity(payload["metadata"])
    if (set(payload["metadata"])!=set(REPORT_IDENTITY) or
            _utf16_units(payload["content"])!=identity["total_characters"]):
        raise ValueError("Report content or provenance does not match")
    canonical = json.dumps(payload,sort_keys=True,separators=(",",":"),
                           ensure_ascii=True).encode("utf-8")
    digest = hashlib.sha256(canonical).hexdigest()
    if envelope["payload_sha256"]!=digest:
        raise ValueError("Report checkpoint SHA-256 mismatch")
    return {"verified":True,"read_only":True,"complete":True,
            "apply_authorized":False,"model_state_restored":False,
            "program_path":identity["program_path"],"format":identity["format"],
            "report_generation":identity["generation"],
            "total_characters":identity["total_characters"],
            "payload_sha256":digest}


REPORT_SET_FORMATS=("markdown","config_csv","names_csv")
REPORT_SET_MAX_BYTES=7500000


def _report_set_manifest(response):
    """Strict shared Program and per-format identity from one Ghidra EDT turn."""
    if not isinstance(response,dict):
        raise ValueError("Missing report-set manifest")
    base={"schema","kind","revision","program_revision","stage_epoch",
          "program_path","import_sha256","profile","scope","formats"}
    if (set(response)!=base or type(response["schema"])!=int
            or response["schema"]!=1
            or response["kind"]!="ghidrassist-hardware-report-set-manifest"
            or not isinstance(response["formats"],dict)
            or set(response["formats"])!=set(REPORT_SET_FORMATS)):
        raise ValueError("Invalid report-set manifest schema")
    generations=[]
    for fmt in REPORT_SET_FORMATS:
        fmt_data=response["formats"][fmt]
        if not isinstance(fmt_data,dict) or set(fmt_data)!={
                "generation","total_characters","sha256_utf8"}:
            raise ValueError("Wrong per-format manifest fields")
        digest=fmt_data["sha256_utf8"]
        if not isinstance(digest,str) or not re.fullmatch(
                r"[0-9a-f]{64}",digest):
            raise ValueError("Invalid manifest content hash")
        values={k:response[k] for k in (
            "revision","program_revision","stage_epoch","import_sha256",
            "profile","program_path","scope")}
        values.update(format=fmt,generation=fmt_data["generation"],
                      total_characters=fmt_data["total_characters"])
        _report_identity(values)
        generations.append(fmt_data["generation"])
    if len(set(generations))!=len(generations):
        raise ValueError("Report formats reused generation token")
    return response


def _collect_report_set_section(session,fmt,manifest,page_size):
    """One complete report, bound to the full multi-format scan manifest."""
    section=manifest["formats"][fmt]
    first=rpc(session,"analysis.export",{
        "format":fmt,"offset":0,"limit":page_size})["report"]
    meta=_report_identity(first)
    for field in ("revision","program_revision","stage_epoch","import_sha256",
                  "profile","program_path","scope"):
        if meta[field]!=manifest[field]:
            raise ValueError("Report Program or analysis changed between formats")
    if (meta["format"]!=fmt or
            meta["generation"]!=section["generation"] or
            meta["total_characters"]!=section["total_characters"]):
        raise ValueError("Wrong report generation or content size")
    offset=0
    fragments=[]
    current=first
    while True:
        units=_report_page_check(current,meta,offset,page_size)
        fragments.append(current["text"])
        offset+=units
        if not current["more"]:
            if offset!=meta["total_characters"]:
                raise ValueError("Truncated report section")
            break
        current=rpc(session,"analysis.export",{
            "format":fmt,"offset":offset,"limit":page_size,
            "expected_revision":meta["revision"],
            "expected_generation":meta["generation"]})["report"]
    content="".join(fragments).encode(
        "utf-16-le","surrogatepass").decode("utf-16-le")
    if (_utf16_units(content)!=meta["total_characters"] or
            hashlib.sha256(content.encode("utf-8")).hexdigest()!=
            section["sha256_utf8"]):
        raise ValueError("Report section content SHA or UTF-16 size changed")
    return content,meta,offset


def _confirm_report_set_terminal(session,fmt,meta,offset,page_size):
    terminal=rpc(session,"analysis.export",{
        "format":fmt,"offset":offset,"limit":page_size,
        "expected_revision":meta["revision"],
        "expected_generation":meta["generation"]})["report"]
    if (_report_page_check(terminal,meta,offset,page_size)!=0 or
            terminal["more"] or terminal["text"]):
        raise ValueError("Report generation changed before final publication")


def capture_report_set_checkpoint(session,output,page_size=4096):
    """Capture three complete formats as ONE bounded, read-only transaction."""
    if type(page_size)!=int or not 1<=page_size<=8192:
        raise ValueError("Invalid report-set page size")
    initial=_report_set_manifest(
        rpc(session,"analysis.report.manifest",{})["manifest"])
    reports={}
    cursors={}
    for fmt in REPORT_SET_FORMATS:
        content,meta,offset=_collect_report_set_section(
            session,fmt,initial,page_size)
        reports[fmt]=content
        cursors[fmt]=(meta,offset)
    # An intermediate Apply/Undo/Redo or new Analyze cannot publish a set
    # with one new member or an old generation, even when the input SHA
    # and apparent Ghidra Program revision happen to match again.
    for fmt in REPORT_SET_FORMATS:
        meta,offset=cursors[fmt]
        _confirm_report_set_terminal(session,fmt,meta,offset,page_size)
    final=_report_set_manifest(
        rpc(session,"analysis.report.manifest",{})["manifest"])
    if final!=initial:
        raise ValueError("Program, scan or report manifest changed during export")
    payload={"schema":1,"kind":"ghidrassist-readonly-hardware-report-set",
             "manifest":initial,"reports":reports,"complete":True,
             "read_only":True,"apply_authorized":False,
             "model_state_restored":False,
             "notice":"STATIC REPORT EVIDENCE ONLY: no firmware execution, trusted actor, Review/Apply or model continuation"}
    raw=json.dumps(payload,sort_keys=True,separators=(",",":"),
                   ensure_ascii=True).encode("utf-8")
    digest=hashlib.sha256(raw).hexdigest()
    data=(json.dumps({"payload":payload,"payload_sha256":digest},
                     indent=2,ensure_ascii=True)+"\n").encode("utf-8")
    if len(data)>REPORT_SET_MAX_BYTES:
        raise ValueError("Combined report checkpoint exceeds byte cap")
    dest=Path(output).expanduser()
    if not dest.parent.is_dir() or dest.parent.is_symlink():
        raise ValueError("Report-set directory must already exist and not be symlink")
    temp=None
    try:
        fd,temp=tempfile.mkstemp(prefix=".ghidrassist-report-set-",dir=dest.parent)
        with os.fdopen(fd,"wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.link(temp,dest)
    finally:
        if temp is not None:
            os.unlink(temp)
    return {"saved":str(dest),"payload_sha256":digest,"complete":True,
            "read_only":True,"apply_authorized":False,
            "formats":list(REPORT_SET_FORMATS),
            "program_revision":initial["program_revision"],
            "stage_epoch":initial["stage_epoch"]}


def verify_report_set_checkpoint(source):
    """Offline bounded content SHA, metadata and disabled authorization check."""
    with Path(source).expanduser().open("rb") as stream:
        raw=stream.read(REPORT_SET_MAX_BYTES+1)
    if not raw or len(raw)>REPORT_SET_MAX_BYTES:
        raise ValueError("Missing or oversized report-set checkpoint")
    obj=_decode_checkpoint_json(raw)
    if not isinstance(obj,dict) or set(obj)!={"payload","payload_sha256"}:
        raise ValueError("Invalid report-set envelope")
    data=obj["payload"]
    if not isinstance(data,dict) or set(data)!={
            "schema","kind","manifest","reports","complete",
            "read_only","apply_authorized","model_state_restored","notice"}:
        raise ValueError("Wrong report-set fields")
    if (type(data["schema"])!=int or data["schema"]!=1
            or data["kind"]!="ghidrassist-readonly-hardware-report-set"
            or data["complete"] is not True
            or data["read_only"] is not True
            or data["apply_authorized"] is not False
            or data["model_state_restored"] is not False
            or not isinstance(data["notice"],str) or
            not data["notice"].startswith("STATIC REPORT EVIDENCE ONLY")):
        raise ValueError("Untrusted or authorized report-set payload")
    manifest=_report_set_manifest(data["manifest"])
    reports=data["reports"]
    if not isinstance(reports,dict) or set(reports)!=set(REPORT_SET_FORMATS):
        raise ValueError("Report set has missing or extra formats")
    for fmt in REPORT_SET_FORMATS:
        text=reports[fmt]
        if (not isinstance(text,str) or
                _utf16_units(text)!=manifest["formats"][fmt]["total_characters"] or
                hashlib.sha256(text.encode("utf-8")).hexdigest()!=
                manifest["formats"][fmt]["sha256_utf8"]):
            raise ValueError("Invalid report section integrity: "+fmt)
    canon=json.dumps(data,sort_keys=True,separators=(",",":"),
                     ensure_ascii=True).encode("utf-8")
    digest=hashlib.sha256(canon).hexdigest()
    if digest!=obj["payload_sha256"]:
        raise ValueError("Report-set SHA256 changed")
    return {"verified":True,"complete":True,"read_only":True,
            "apply_authorized":False,"model_state_restored":False,
            "formats":list(REPORT_SET_FORMATS),
            "report_generations":{
                fmt:manifest["formats"][fmt]["generation"] for fmt in REPORT_SET_FORMATS},
            "program_path":manifest["program_path"],
            "program_revision":manifest["program_revision"],
            "payload_sha256":digest}


def capture_agentic_checkpoint(session, output, page_size=100, parent=None):
    """Explicit local read-only evidence export; never a resumable AI session."""
    if not 1 <= page_size <= 100:
        raise ValueError("Agentic checkpoint page size must be 1..100")
    first = rpc(session, "agentic.findings.page", {"offset": 0, "limit": page_size})["agentic"]
    expected = (first["run"], first["programRevision"], first["importSha256"],
                first["state"], first["findings"]["revision"],
                first["findings"]["retainedCount"],first["findings"]["acceptedCount"],
                first["findings"]["evictedCount"],first["findings"]["sourceIncomplete"])
    if expected[5] > 1000 or expected[5] < 0:
        raise ValueError("Unbounded Agentic evidence count")
    rows = list(first["findings"]["rows"])
    if len(rows) > page_size or len(rows) > expected[5]:
        raise ValueError("Inconsistent first Agentic page")
    current = first
    while current["findings"]["hasMore"]:
        offset = len(rows)
        if offset >= expected[5] or len(rows) >= 1000:
            raise ValueError("Agentic pagination made no bounded progress")
        current = rpc(session, "agentic.findings.page", {
            "offset": offset, "limit": page_size,
            "expected_run": expected[0],
            "expected_program_revision": expected[1],
            "expected_findings_revision": expected[4],
        })["agentic"]
        now = (current["run"],current["programRevision"],current["importSha256"],
               current["state"],current["findings"]["revision"],
               current["findings"]["retainedCount"],current["findings"]["acceptedCount"],
               current["findings"]["evictedCount"],current["findings"]["sourceIncomplete"])
        if now != expected:
            raise ValueError("Agentic findings changed during evidence checkpoint")
        chunk = current["findings"]["rows"]
        if not chunk or len(chunk)>page_size or len(rows)+len(chunk)>expected[5]:
            raise ValueError("Agentic pagination inconsistent or stalled")
        rows.extend(chunk)
    if len(rows)!=expected[5]:
        raise ValueError("Agentic checkpoint omitted retained rows")
    # A nonzero-offset page is never individually complete. Complete here
    # means the entire unchanged run was stitched without omissions AND
    # every retained finding has its own attributable observation/tool.
    # This also guards older Agentic providers which did not track the
    # missing-source count independently of their success state.
    all_attributed = all(
        isinstance(row, dict) and all(
            isinstance(row.get(field), str) and row[field].strip()
            for field in ("fact", "evidence", "toolUsed"))
        for row in rows)
    complete = bool(all_attributed and
                    expected[3]=="SUCCESS" and expected[5]>0 and
                    len(expected[2])==64 and
                    all(c in "0123456789abcdefABCDEF" for c in expected[2]) and
                    expected[6]==expected[5] and expected[7]==0 and not expected[8])
    payload = {
        "schema": 1, "kind": "ghidrassist-agentic-retained-evidence",
        "run": expected[0], "program_revision": expected[1],
        "import_sha256": expected[2], "state": expected[3],
        "findings_revision": expected[4], "retained_count": expected[5],
        "accepted_count": expected[6], "evicted_count": expected[7],
        "source_incomplete": expected[8], "complete": complete,
        "rows": rows,
        "notice": "Read-only retained evidence, NOT an AI session, approval, runtime ISR or exhaustive firmware proof",
    }
    if parent is not None:
        prior, prior_hash = load_verified_agentic_payload(parent)
        if not prior["complete"] or not complete:
            raise ValueError("Cannot link incomplete historical or new evidence")
        if prior["import_sha256"].lower() != payload["import_sha256"].lower():
            raise ValueError("Source firmware changed between independent analyses")
        if prior["run"] == payload["run"]:
            raise ValueError("Cannot link checkpoint to the same run")
        # This is provenance metadata only, never approval or an AI resume.
        payload["parent_checkpoint_sha256"] = prior_hash
        payload["parent_run"] = prior["run"]
        payload["continuation_kind"] = "new-independently-reviewed-run"
    canonical = json.dumps(payload,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode("utf-8")
    envelope = {"payload":payload,"payload_sha256":hashlib.sha256(canonical).hexdigest()}
    data=(json.dumps(envelope,indent=2,ensure_ascii=False)+"\n").encode("utf-8")
    if len(data)>8*1024*1024:
        raise ValueError("Agentic checkpoint exceeds local 8 MiB cap")
    dest=Path(output).expanduser()
    if not dest.parent.is_dir():
        raise ValueError("Agentic checkpoint destination directory must exist")
    temp=None
    try:
        fd,temp=tempfile.mkstemp(prefix=".ghidrassist-agentic-",dir=dest.parent)
        with os.fdopen(fd,"wb") as fp:
            fp.write(data)
            fp.flush()
            os.fsync(fp.fileno())
        # Atomic create-no-overwrite; no truncating existing user reports.
        os.link(temp,dest)
    finally:
        if temp is not None:
            os.unlink(temp)
    return {"saved":str(dest),"complete":complete,"retained_count":len(rows),
            "payload_sha256":envelope["payload_sha256"]}


def load_verified_agentic_payload(source):
    """Read and validate one bounded offline snapshot; never contacts Ghidra."""
    src=Path(source).expanduser()
    # Bound the actual read, not only a prior stat(): the file may grow
    # between metadata inspection and open. Never consume an unbounded file.
    with src.open("rb") as handle:
        raw=handle.read(8*1024*1024+1)
    if len(raw)>8*1024*1024:
        raise ValueError("Oversized local Agentic checkpoint")
    # One captured buffer prevents mixing different file generations.
    report=_decode_checkpoint_json(raw)
    if not isinstance(report,dict):
        raise ValueError("Invalid Agentic evidence checkpoint envelope")
    payload=report["payload"]
    if not isinstance(payload,dict) or payload.get("schema")!=1 or payload.get("kind")!="ghidrassist-agentic-retained-evidence":
        raise ValueError("Unsupported Agentic evidence checkpoint schema")
    canonical=json.dumps(payload,sort_keys=True,separators=(",",":"),ensure_ascii=False).encode("utf-8")
    digest=hashlib.sha256(canonical).hexdigest()
    if digest!=report.get("payload_sha256"):
        raise ValueError("Agentic checkpoint SHA-256 mismatch")
    rows=payload["rows"]
    kept=payload["retained_count"]
    accepted=payload["accepted_count"]
    evicted=payload["evicted_count"]
    if (not isinstance(rows,list) or type(kept)!=int or type(accepted)!=int or
            type(evicted)!=int or not 0<=kept<=1000 or len(rows)!=kept or
            not accepted>=kept or not evicted==accepted-kept):
        raise ValueError("Inconsistent Agentic evidence counters")
    if (type(payload.get("complete"))!=bool or
            type(payload.get("source_incomplete"))!=bool or
            payload.get("state") not in ("RUNNING","SUCCESS","CANCELLED",
                "MAX_ITERATIONS","MAX_TOOLS","ERROR") or
            type(payload.get("program_revision"))!=int or
            payload["program_revision"]<0 or
            type(payload.get("findings_revision"))!=int or
            payload["findings_revision"]<0 or
            not isinstance(payload.get("run"),str) or not payload["run"] or
            not isinstance(payload.get("import_sha256"),str)):
        raise ValueError("Invalid Agentic checkpoint metadata")
    sha=payload["import_sha256"]
    has_identity=(len(sha)==64 and all(c in "0123456789abcdefABCDEF" for c in sha))
    if payload["complete"] and (payload["state"]!="SUCCESS" or kept==0 or
            evicted>0 or payload["source_incomplete"] or not has_identity):
        raise ValueError("False-complete Agentic evidence checkpoint")
    lineage_keys=("parent_checkpoint_sha256","parent_run","continuation_kind")
    if any(key in payload for key in lineage_keys):
        if not all(key in payload for key in lineage_keys):
            raise ValueError("Incomplete checkpoint ancestry fields")
        parent_sha=payload["parent_checkpoint_sha256"]
        if (not isinstance(parent_sha,str) or len(parent_sha)!=64 or
                any(c not in "0123456789abcdef" for c in parent_sha) or
                not isinstance(payload["parent_run"],str) or
                not 1<=len(payload["parent_run"])<=128 or
                payload["parent_run"]==payload["run"] or
                payload["continuation_kind"]!="new-independently-reviewed-run"):
            raise ValueError("Invalid historical checkpoint ancestry")
    for row in rows:
        if (not isinstance(row,dict) or
                not all(field in row for field in ("fact","evidence","toolUsed")) or
                not all((row.get(field) is None or
                         (isinstance(row.get(field),str) and len(row[field])<=limit))
                        for field,limit in
                        (("fact",2048),("evidence",2048),("toolUsed",128))) or
                type(row.get("relevance"))!=int or
                type(row.get("timestamp"))!=int or row["timestamp"]<0):
            raise ValueError("Invalid Agentic evidence row")
        if payload["complete"] and any(
                not isinstance(row.get(field), str) or
                not row[field].strip()
                for field in ("fact", "evidence", "toolUsed")):
            raise ValueError(
                "False-complete Agentic evidence checkpoint: missing row attribution")
    return payload,digest


def check_agentic_resume_preflight(session, source):
    """Compare every saved row to live Ghidra evidence; never authorize replay."""
    payload, digest = load_verified_agentic_payload(source)
    if payload["state"] == "RUNNING":
        raise ValueError("Running checkpoint is not a terminal handoff")
    if payload["import_sha256"] == "UNKNOWN":
        raise ValueError("Checkpoint lacks verified firmware import identity")
    # Bounded by the checkpoint validator (at most 1000 retained rows).
    # A page of matching counters is insufficient: require exact observed
    # row contents and the same source generation on EVERY live page.
    observed = []
    page_limit = 100
    while True:
        offset = len(observed)
        params = {"offset": offset, "limit": page_limit,
                  "expected_program_revision": payload["program_revision"]}
        if offset:
            params["expected_run"] = payload["run"]
            params["expected_findings_revision"] = payload["findings_revision"]
        reply = rpc(session, "agentic.findings.page", params)
        if reply.get("read_only") is not True:
            raise ValueError("Live Agentic source is not explicitly read-only")
        live = reply["agentic"]
        current = live["findings"]
        if (live["programRevision"] != payload["program_revision"] or
                live["importSha256"] != payload["import_sha256"] or
                live["run"] != payload["run"] or
                live["state"] != payload["state"] or
                current["revision"] != payload["findings_revision"] or
                current["retainedCount"] != payload["retained_count"] or
                current["acceptedCount"] != payload["accepted_count"] or
                current["evictedCount"] != payload["evicted_count"] or
                current["sourceIncomplete"] != payload["source_incomplete"]):
            raise ValueError("Active Agentic evidence generation changed")
        chunk = current["rows"]
        if (not isinstance(chunk, list) or len(chunk) > page_limit or
                len(observed) + len(chunk) > payload["retained_count"] or
                (current["hasMore"] and not chunk)):
            raise ValueError("Live Agentic pagination inconsistent or stalled")
        expected_chunk = payload["rows"][offset:offset + len(chunk)]
        if chunk != expected_chunk:
            raise ValueError("Active Agentic findings content differs from checkpoint")
        observed.extend(chunk)
        if not current["hasMore"]:
            break
    if len(observed) != payload["retained_count"]:
        raise ValueError("Active Agentic findings missing retained rows")
    # A match only permits a human to review source evidence. No tools,
    # LLM state or Apply authorizations are copied into the new task.
    return {
        "verified_sha256": digest, "identity_matches": True,
        "evidence_matches": True, "source_complete": payload["complete"],
        "read_only": True, "resumable_ai_session": False,
        "tool_execution_authorized": False, "apply_authorized": False,
        "next_action": "NEW_REVIEW_REQUIRED",
        "notice": "Preflight only; a new independent, reviewed investigation is required",
    }


def create_agentic_review_draft(session, source, destination, query, ancestors=None):
    """Create a new human-review proposal; never import prior approvals."""
    if not isinstance(query, str) or not 8 <= len(query) <= 512 or any(
            ord(ch) < 32 and ch not in "\t\n" for ch in query):
        raise ValueError("New analysis objective must be 8..512 readable characters")
    # Linked historical data must carry every predecessor back to an
    # unlinked root. A single rehashed child file is not verified ancestry.
    ancestry = list(ancestors or [])
    candidate, candidate_digest = load_verified_agentic_payload(source)
    has_parent = "parent_checkpoint_sha256" in candidate
    if has_parent != bool(ancestry):
        raise ValueError("Historical review source requires its full ancestor chain")
    provenance = (verify_agentic_lineage_chain(source, ancestry)
                  if has_parent else None)
    # Verify once against actual active Ghidra, then re-read from disk and
    # assert byte-equivalent canonical SHA; a concurrent replacement of the
    # checkpoint between preflight and export must fail closed.
    preflight = check_agentic_resume_preflight(session, source)
    payload, digest = load_verified_agentic_payload(source)
    if digest != preflight["verified_sha256"] or digest != candidate_digest:
        raise ValueError("Checkpoint changed after live source verification")
    if provenance is not None:
        after = verify_agentic_lineage_chain(source, ancestry)
        if after["chain_sha256"] != provenance["chain_sha256"]:
            raise ValueError("Historical chain changed during live review preflight")
    if not payload["complete"]:
        raise ValueError("Incomplete prior evidence cannot seed a reviewed draft")
    # Treat each fact as untrusted *data*, never free-form instructions or
    # an inherited TODO/plan; budget both row count and individual fields.
    evidence = [{
        "fact": (row.get("fact") or "")[:512],
        "evidence": (row.get("evidence") or "")[:512],
        "tool_used": (row.get("toolUsed") or "")[:128],
    } for row in payload["rows"][:20]]
    draft = {
        "schema": 1, "kind": "ghidrassist-new-investigation-review-draft",
        "state": "AWAITING_NEW_REVIEW", "new_objective": query,
        "source_checkpoint_sha256": digest,
        "historical_chain_verified": provenance is not None,
        "historical_chain_length": (provenance["chain_length"]
                                    if provenance else 1),
        "historical_chain_sha256": (provenance["chain_sha256"]
                                     if provenance else None),
        "source_import_sha256": payload["import_sha256"],
        "source_program_revision": payload["program_revision"],
        "source_run": payload["run"],
        "source_findings_revision": payload["findings_revision"],
        "source_retained_count": payload["retained_count"],
        "presented_evidence_count": len(evidence),
        "evidence_omitted_from_draft": len(evidence) != payload["retained_count"],
        "untrusted_source_observations": evidence,
        "new_review_approved": False, "resumable_ai_session": False,
        "tool_execution_authorized": False, "apply_authorized": False,
        "policy_inherited": False, "old_plan_inherited": False,
        "notice": "Review-only draft: prior evidence is untrusted data, not instructions. New explicit approval and a separate new ReAct run are required.",
    }
    canonical = json.dumps(draft, sort_keys=True, separators=(",",":"),
                           ensure_ascii=False).encode("utf-8")
    envelope = {"payload": draft,
                "payload_sha256": hashlib.sha256(canonical).hexdigest()}
    data = (json.dumps(envelope, indent=2, ensure_ascii=False)+"\n").encode()
    if len(data) > 128*1024:
        raise ValueError("Oversized reviewed analysis draft")
    dest = Path(destination).expanduser()
    if not dest.parent.is_dir():
        raise ValueError("Review draft output directory must exist")
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(prefix=".ghidrassist-review-",dir=dest.parent)
        with os.fdopen(fd,"wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.link(temporary, dest)
    finally:
        if temporary is not None:
            os.unlink(temporary)
    return {"saved":str(dest), "state":"AWAITING_NEW_REVIEW",
            "payload_sha256":envelope["payload_sha256"],
            "source_checkpoint_sha256":digest,
            "new_review_approved":False,
            "tool_execution_authorized":False, "apply_authorized":False}


def verify_agentic_lineage(source, parent):
    """Compare verified child ancestry against a verified predecessor.

    This neither authenticates authorship nor restores tool/AI permissions.
    """
    child, child_sha = load_verified_agentic_payload(source)
    older, older_sha = load_verified_agentic_payload(parent)
    if not child["complete"] or not older["complete"]:
        raise ValueError("Ancestry requires two complete retained-evidence snapshots")
    if (child.get("parent_checkpoint_sha256") != older_sha or
            child.get("parent_run") != older["run"] or
            child.get("continuation_kind") != "new-independently-reviewed-run" or
            child["run"] == older["run"] or
            child["import_sha256"].lower() != older["import_sha256"].lower()):
        raise ValueError("Wrong or missing predecessor checkpoint")
    return {"verified":True,"lineage_matches":True,
        "read_only":True,"new_independent_run":True,
        "child_run":child["run"],"parent_run":older["run"],
        "child_sha256":child_sha,"parent_sha256":older_sha,
        "model_state_restored":False,"authorizes_tools":False,
        "authorizes_apply":False,
        "notice":"Untrusted historical provenance only; no authenticated author or LLM state"}
    

def verify_agentic_lineage_chain(source, ancestors):
    """Verify a bounded, complete historical chain oldest -> newest offline.

    Every checkpoint is independently SHA-256 integrity checked, every edge
    must reference the EXACT previous payload SHA and opaque run, and the
    oldest checkpoint must be a self-contained root without missing ancestry.
    This neither signs an author nor resumes any model, tool, or approval.
    """
    if not isinstance(ancestors, (list, tuple)) or not 1 <= len(ancestors) <= 15:
        raise ValueError("Historical chain requires 1..15 ordered ancestors")
    checkpoints = list(ancestors) + [source]
    verified = []
    identities = set()
    runs = set()
    imported = None
    for index, path in enumerate(checkpoints):
        payload, digest = load_verified_agentic_payload(path)
        if not payload["complete"]:
            raise ValueError("Incomplete evidence in historical chain")
        if digest in identities or payload["run"] in runs:
            raise ValueError("Historical chain repeats a checkpoint or run")
        identities.add(digest)
        runs.add(payload["run"])
        if imported is None:
            imported = payload["import_sha256"].lower()
        elif payload["import_sha256"].lower() != imported:
            raise ValueError("Historical chain switched firmware import")
        if index == 0:
            if any(key in payload for key in
                   ("parent_checkpoint_sha256", "parent_run",
                    "continuation_kind")):
                raise ValueError("Historical root has missing ancestors")
        else:
            prior, prior_digest = verified[-1]
            if (payload.get("parent_checkpoint_sha256") != prior_digest or
                    payload.get("parent_run") != prior["run"] or
                    payload.get("continuation_kind") !=
                    "new-independently-reviewed-run"):
                raise ValueError("Broken historical checkpoint edge")
        verified.append((payload, digest))
    metadata = [{
        "run": payload["run"],
        "program_revision": payload["program_revision"],
        "findings_revision": payload["findings_revision"],
        "retained_count": payload["retained_count"],
        "payload_sha256": digest,
    } for payload, digest in verified]
    identity = {"schema": 1, "import_sha256": imported,
                "checkpoints": metadata}
    fingerprint = hashlib.sha256(json.dumps(
        identity, sort_keys=True, separators=(",",":"),
        ensure_ascii=False).encode("utf-8")).hexdigest()
    return {
        "verified": True, "read_only": True,
        "lineage_matches": True, "root_self_contained": True,
        "chain_length": len(verified),
        "import_sha256": imported,
        "chain_sha256": fingerprint,
        "runs": [entry["run"] for entry in metadata],
        "checkpoints": metadata,
        "model_state_restored": False,
        "authorizes_tools": False, "authorizes_apply": False,
        "old_approvals_inherited": False,
        "notice": "Untrusted historical SHA-256 provenance, NOT actor authentication or permission to resume AI/Apply",
    }


def verify_agentic_checkpoint(source):
    """Offline SHA-256 integrity check; never authenticates the original actor."""
    payload,digest=load_verified_agentic_payload(source)
    return {"verified":True,"complete":payload["complete"],
        "retained_count":payload["retained_count"],"payload_sha256":digest,
        "notice":"SHA-256 integrity only; no authenticated actor or LLM session restore"}


def read_agentic_checkpoint_page(source,offset=0,limit=25):
    """Offline paged evidence browsing; never resumes a model or tool session."""
    if type(offset)!=int or type(limit)!=int or not 0<=offset<=1000000 or not 1<=limit<=100:
        raise ValueError("Invalid bounded offline Agentic page")
    payload,digest=load_verified_agentic_payload(source)
    rows=payload["rows"]
    start=min(offset,len(rows))
    end=min(start+limit,len(rows))
    return {
        "offline":True,"read_only":True,"verified_sha256":digest,
        "run":payload["run"],"program_revision":payload["program_revision"],
        "import_sha256":payload["import_sha256"],
        "state":payload["state"],"source_complete":payload["complete"],
        "source_incomplete":payload["source_incomplete"],
        "accepted_count":payload["accepted_count"],
        "evicted_count":payload["evicted_count"],
        "retained_count":len(rows),"offset":offset,"limit":limit,
        "has_more":end<len(rows),
        "page_complete":offset==0 and end==len(rows) and payload["complete"],
        "rows":rows[start:end],
        "notice":"Previously saved source evidence only; not live Ghidra, an LLM resume or firmware execution",
    }


