#!/usr/bin/env python3
"""GhidrAssist local Automation API v3 client; standard library only."""
import argparse
import json
import os
from pathlib import Path
import sys
from urllib.request import Request, urlopen
from urllib.error import HTTPError


def load_session(path):
    location = Path(path).expanduser()
    session = json.loads(location.read_text(encoding="utf-8"))
    if session.get("schema") != 3 or not (0 < session["port"] < 65536):
        raise ValueError("Invalid Automation session")
    return session


def rpc(session, method, params=None):
    payload = json.dumps({"method": method, "params": params or {}}).encode()
    req = Request(
        "http://127.0.0.1:%d/rpc" % session["port"],
        data=payload,
        headers={"Content-Type": "application/json",
                 "Authorization": "Bearer " + session["token"]},
        method="POST",
    )
    with urlopen(req, timeout=45) as answer:
        return json.loads(answer.read(1048576))


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--session", default=os.environ.get(
        "GHIDRASSIST_AGENT_SESSION", str(Path.home() / ".local/state/ghidrassist-agent/session.json")))
    parser.add_argument("action", choices=("status", "snapshot", "analyze", "task", "mmio", "review-preview", "profile-select", "function", "xrefs", "listing", "goto"))
    parser.add_argument("address", nargs="?")
    parser.add_argument("--filter", default="")
    parser.add_argument("--offset", type=int, default=0)
    parser.add_argument("--limit", type=int, default=100)
    args = parser.parse_args()
    session = load_session(args.session)
    method = {"status": "session.status", "snapshot": "ui.snapshot",
              "analyze": "hardware.analyze", "task": "hardware.task",
              "mmio": "hardware.mmio.rows", "review-preview": "hardware.review.preview", "profile-select": "hardware.profile.select", "function": "function.snapshot", "xrefs": "function.xrefs", "listing": "listing.snapshot",
              "goto": "listing.goto"}[args.action]
    if method == "listing.goto" and not args.address:
        parser.error("goto requires an address")
    if method == "hardware.profile.select" and args.address not in ("CPU32_SURVEY", "MC68332_USER_SELECTED"):
        parser.error("profile-select requires CPU32_SURVEY or MC68332_USER_SELECTED")
    try:
        params = ({"profile": args.address} if method == "hardware.profile.select" else
                  {"address": args.address} if args.address else
                  {"filter": args.filter, "offset": args.offset, "limit": args.limit}
                  if method in ("hardware.mmio.rows", "hardware.review.preview", "function.xrefs") else {})
        reply = rpc(session, method, params)
        print(json.dumps(reply, indent=2))
    except HTTPError as error:
        print(error.read().decode("utf-8", errors="replace"), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
